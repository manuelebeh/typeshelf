{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typeshelf",
  "version": "0.1.0",
  "identifier": "dev.typeshelf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typeshelf",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#161618",
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' tsfont: http://tsfont.localhost https://fonts.gstatic.com; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Font manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/photoshop/": "plugins/photoshop/",
      "../plugins/illustrator/": "plugins/illustrator/",
      "../plugins/after-effects/": "plugins/after-effects/",
      "../plugins/sketch/": "plugins/sketch/"
    }
  }
}
