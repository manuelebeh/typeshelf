{
  "name": "Typeshelf",
  "description": "Activates the fonts open documents are missing, and applies the ones chosen in Typeshelf.",
  "author": "Typeshelf",
  "identifier": "dev.typeshelf.sketch",
  "version": "0.1.0",
  "compatibleVersion": "53",
  "disableCocoaScriptPreprocessor": true,
  "commands": [
    {
      "name": "Activate Missing Fonts",
      "identifier": "activate",
      "script": "typeshelf.js",
      "handlers": {
        "run": "onActivate",
        "actions": { "Startup": "onStartup", "OpenDocument": "onOpenDocument" }
      }
    },
    {
      "name": "Preview in Typeshelf",
      "identifier": "preview",
      "script": "typeshelf.js",
      "handler": "onPreview"
    },
    {
      "name": "Settings…",
      "identifier": "settings",
      "script": "typeshelf.js",
      "handler": "onSettings"
    }
  ],
  "menu": {
    "title": "Typeshelf",
    "items": ["activate", "preview", "settings"]
  }
}
