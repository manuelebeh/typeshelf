{
  "name": "Typeshelf",
  "description": "Activates in Typeshelf the fonts that open documents are missing.",
  "author": "Typeshelf",
  "identifier": "dev.typeshelf.sketch",
  "version": "0.1.0",
  "compatibleVersion": "53",
  "disableCocoaScriptPreprocessor": true,
  "commands": [
    {
      "name": "Activate Missing Fonts",
      "identifier": "activate",
      "script": "typeshelf.js",
      "handlers": {
        "run": "onActivate",
        "actions": { "OpenDocument": "onOpenDocument" }
      }
    },
    {
      "name": "Settings…",
      "identifier": "settings",
      "script": "typeshelf.js",
      "handler": "onSettings"
    }
  ],
  "menu": {
    "title": "Typeshelf",
    "items": ["activate", "settings"]
  }
}
