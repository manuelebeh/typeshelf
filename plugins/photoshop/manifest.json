{
  "manifestVersion": 5,
  "id": "dev.typeshelf.photoshop",
  "name": "Typeshelf",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.2.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "startup"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "typeshelfPanel",
      "label": {
        "default": "Typeshelf"
      },
      "minimumSize": {
        "width": 230,
        "height": 200
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 320
      },
      "preferredFloatingSize": {
        "width": 280,
        "height": 380
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://localhost"
      ]
    }
  }
}
